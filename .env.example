# Copy this file to .env and fill in your real values. Never commit .env itself.

GOOGLE_PLACES_API_KEY=your_api_key_here

# --- Google Sheets output (optional — leave blank to skip) ---
# Path to the service account JSON file you downloaded from Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# --- Email digest output (optional — leave blank to skip) ---
# KTZ mail server (SSL on port 465 — SMTP_PASSWORD is the normal mailbox password):
SMTP_HOST=smtp.ktzmedia.co.za
SMTP_PORT=465
SMTP_USER=jabu@ktzmedia.co.za
SMTP_PASSWORD=your_mailbox_password
EMAIL_TO=jabu@ktzmedia.co.za
